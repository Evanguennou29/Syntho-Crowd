# Supabase PostgreSQL connection, using the direct endpoint or SESSION pooler, not transaction pooler.
# Encode special characters in the database password. Keep TLS enabled.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Create this PRIVATE bucket in Supabase Storage before the first campaign.
STORAGE_BUCKET=sc-artifacts-v2
GEMINI_API_KEY=
LLM_MODEL=gemini/gemini-2.5-flash
# Generate independent random values. API_TOKEN >=32 chars; APP_PASSWORD >=16 chars.
API_TOKEN=
APP_USERNAME=admin
APP_PASSWORD=
APP_PORT=3000
MAX_CAMPAIGN_RUNS=100
MAX_STEPS=40
SESSION_TIMEOUT=600
# Limit per agent; keep concurrency=1 until provider quotas are measured.
MAX_RPM=15
# Optional exact host allowlist, including redirect hosts and required asset/CDN hosts.
TARGET_ALLOWED_HOSTS=
