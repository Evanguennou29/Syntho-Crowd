FROM ghcr.io/astral-sh/uv:0.13.7 AS uv
FROM python:3.12-slim-bookworm
COPY --from=uv /uv /uvx /usr/local/bin/
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_LINK_MODE=copy \
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright CREWAI_TELEMETRY_DISABLED=true \
    OTEL_SDK_DISABLED=true
WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --locked --no-dev --extra worker --no-install-project \
    && .venv/bin/playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*
COPY backend/app ./app
RUN uv sync --locked --no-dev --extra worker \
    && useradd --create-home --uid 10001 syntho \
    && mkdir -p /tmp/synthocrowd && chown syntho:syntho /tmp/synthocrowd
ENV PATH="/app/.venv/bin:$PATH"
USER syntho
CMD ["celery", "-A", "app.tasks:celery_app", "worker", "--loglevel=INFO", "--concurrency=1"]
